; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jeremy's Box"
run/main_scene="uid://b7dmylcitcvjq"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=120
boot_splash/bg_color=Color(0.129558, 0.129558, 0.129558, 1)
boot_splash/image="uid://b2yw7hkdj5dr6"
config/icon="uid://bd2g2et6p1k4b"
config/windows_native_icon="res://icon.ico"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/return_value_discarded=2

[display]

window/size/viewport_width=400
window/size/viewport_height=225
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/godot_sfxr/plugin.cfg")

[file_customization]

folder_colors={
"res://src/": "red"
}

[global_group]

interactables=""

[input]

click={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":1,"position":Vector2(211, 11),"global_position":Vector2(220, 59),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_4="interactable"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0807833, 0.0807834, 0.0807833, 1)
